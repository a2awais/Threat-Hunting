// Title:        Lsass access credential dumping
// Rationale:    Intended to flag LSASS credential dumping by PowerShell, cmd, rundll32
//               (comsvcs MiniDump), WMIC, ProcDump or Task Manager.
// MITRE ATT&CK: T1003.001 — LSASS Memory
DeviceProcessEvents
| where FileName =~ "lsass.exe"
| where InitiatingProcessFileName in~ ("powershell.exe", "cmd.exe", "rundll32.exe", "wmic.exe", "procdump.exe", "taskmgr.exe", "comsvcs.exe")
| project Timestamp, DeviceName, InitiatingProcessAccountName, FileName, InitiatingProcessFileName, ProcessCommandLine
