// Risky OAuth App Permissions: App-Only and Delegated
// Which enabled apps could an attacker use to read mail, plant credentials or
// escalate privileges, and does anyone still need them?
//
// App-only = the app signs in as itself: no user, no MFA, tenant-wide reach.
// Delegated = the app acts as a user and can't exceed that user's rights.
//
// Review top to bottom: PrivEsc_AppOnly, then DataAccess_AppOnly.
// "(in use)" = the permission is actually exercised. Inactive 90d+ = easiest to disable.
// Verified publisher does not mean safe (see ConnectWise/SkyKick).
//
// Seen in the wild: Midnight Blizzard (2024), ConnectWise/SkyKick (2026)
// Related (not covered here): Vercel/Context.ai (Google Workspace), OneDrive File Picker scope flaw (Oasis)
// MITRE: T1078.004, T1098.001, T1098.003 | Requires: app governance in Defender for Cloud Apps
// Tune: edit the two lists below. OnlyRisky = false lists every enabled app.
let OnlyRisky = true;
let PrivEsc = dynamic(["Application.ReadWrite.All","AppRoleAssignment.ReadWrite.All",
 "RoleManagement.ReadWrite.Directory","Directory.ReadWrite.All",
 "Policy.ReadWrite.ConditionalAccess","UserAuthenticationMethod.ReadWrite.All"]);
let DataAccess = dynamic(["Mail.Send","Mail.ReadWrite","MailboxSettings.ReadWrite",
 "Files.ReadWrite.All","Sites.ReadWrite.All","Sites.FullControl.All","AllSites.Write",
 "full_access_as_app","EWS.AccessAsUser.All"]);
OAuthAppInfo
| where Timestamp > ago(35d)                       // full snapshots land twice a month
| summarize arg_max(Timestamp, *) by OAuthAppId    // latest state per app
| where AppStatus == "Enabled"
| extend LastModified = column_ifexists("LastModifiedTime", Timestamp),
         AddedOn = column_ifexists("AddedOnTime", datetime(null)),
         LastUsed = column_ifexists("LastUsedTime", datetime(null)),
         AdminConsented = column_ifexists("IsAdminConsented", bool(null)),
         ServicePrincipalId = column_ifexists("ServicePrincipalId", ""),
         AppOwnerTenantId = column_ifexists("AppOwnerTenantId", ""),
         VP = parse_json(tostring(VerifiedPublisher))
| extend Publisher = coalesce(tostring(VP.displayName), tostring(VP.DisplayName))
| extend Permissions = iff(array_length(Permissions) > 0, Permissions, dynamic([{}]))
| mv-expand Perm = Permissions
| extend Name = tostring(Perm.PermissionValue),
         Type = tostring(Perm.PermissionType),     // Application or Delegated
         Level = tostring(Perm.PrivilegeLevel),
         InUse = tostring(Perm.InUse),
         Resource = tostring(Perm.TargetAppDisplayName)
| extend Label = strcat(Name, iff(InUse == "true", " (in use)", ""))
| summarize
    PrivEsc_AppOnly = make_set_if(Label, Type == "Application" and Name in~ (PrivEsc)),
    DataAccess_AppOnly = make_set_if(Label, Type == "Application" and Name in~ (DataAccess)),
    DelegatedHigh = make_set_if(Label, Type == "Delegated" and Level == "High"),
    AllPerms = make_set_if(strcat(Resource, ":", Name, " [", Type, "]"), isnotempty(Name)),
    AppName = take_any(AppName), Publisher = take_any(Publisher), AppOrigin = take_any(AppOrigin),
    AppOwnerTenantId = take_any(AppOwnerTenantId), ServicePrincipalId = take_any(ServicePrincipalId),
    AdminConsented = take_any(AdminConsented), AddedOn = take_any(AddedOn),
    LastModified = take_any(LastModified), LastUsed = take_any(LastUsed)
    by OAuthAppId
// Delegated rights only count for external apps with no verified publisher
| extend DelegatedHigh_ExternalUnverified =
    iff(isempty(Publisher) and AppOrigin =~ "External", DelegatedHigh, dynamic([]))
| extend ReviewReason = case(
    array_length(PrivEsc_AppOnly) > 0, "App-only rights to escalate privilege or plant credentials",
    array_length(DataAccess_AppOnly) > 0, "App-only mail / file / site access",
    array_length(DelegatedHigh_ExternalUnverified) > 0, "High-privilege consent on external, unverified app",
    "No risky permissions")
| where ReviewReason != "No risky permissions" or not(OnlyRisky)
| extend Activity = case(isnull(LastUsed), "Unknown", LastUsed < ago(90d), "Inactive 90d+", "Active")
| order by array_length(PrivEsc_AppOnly) desc, array_length(DataAccess_AppOnly) desc, LastModified desc
| project AppName, ReviewReason, Publisher, AppOrigin, AppOwnerTenantId,
          AdminConsented = case(AdminConsented == true, "Yes", AdminConsented == false, "No", "Unknown"),
          Activity, LastUsed = format_datetime(LastUsed, "yyyy-MM-dd"),
          PrivEsc_AppOnly = array_strcat(array_sort_asc(PrivEsc_AppOnly), "; "),
          DataAccess_AppOnly = array_strcat(array_sort_asc(DataAccess_AppOnly), "; "),
          DelegatedHigh_ExternalUnverified = array_strcat(array_sort_asc(DelegatedHigh_ExternalUnverified), "; "),
          TotalPermissions = array_length(AllPerms),
          AllPermissions = array_strcat(array_sort_asc(AllPerms), "; "),
          OAuthAppId, ServicePrincipalId,
          AddedOn = format_datetime(AddedOn, "yyyy-MM-dd"),
          LastModified = format_datetime(LastModified, "yyyy-MM-dd")
