// Title:         Homa Framework PowerShell Stager / JScript Loader
// Rationale:     Volant Manticore's Homa framework, a JScript rewrite of MuddyWater's MuddyC2Go client, loads in PowerShell stages.
//                The stager hides iex by slicing characters out of $PSSessionConfigurationName and pulls the next stage from http://<IP>:8000/<id>.
//                The loader then compiles the backdoor with Add-Type -Language JScript. This hunts any of the three patterns in a PowerShell command line.
//                It won't see stages run with -EncodedCommand or only in memory.
// MITRE ATT&CK:  T1059.001, T1059.007, T1027, T1105
// Ref:            https://research.checkpoint.com/2026/volant-manticore-flying-under-the-radar/
// ----------------------------------------------------------------------------
let Lookback = 30d;
DeviceProcessEvents
| where Timestamp > ago(Lookback)
| where FileName in~ ("powershell.exe", "pwsh.exe")
| where ProcessCommandLine has_any ("PSSessionConfigurationName", "JScript", "Invoke-WebRequest", "iwr")
| where ProcessCommandLine matches regex @"(?i)PSSessionConfigurationName\)?\s*\["
     or (ProcessCommandLine has "Add-Type" and ProcessCommandLine has "JScript")
     or (ProcessCommandLine has_any ("Invoke-WebRequest", "iwr")
         and ProcessCommandLine has_any ("Invoke-Expression", "iex")
         and ProcessCommandLine matches regex @"http://\d{1,3}(\.\d{1,3}){3}:\d{2,5}/")
| project Timestamp, DeviceId, DeviceName, ReportId, AccountDomain, AccountName,
          ProcessCommandLine, ProcessId,
          InitiatingProcessFileName, InitiatingProcessFolderPath, InitiatingProcessSHA256,
          InitiatingProcessCommandLine, InitiatingProcessId,
          InitiatingProcessParentFileName, InitiatingProcessParentId
