// Hunt:         Azure Entra - Service Principal Secret Failure Followed by Success from a New IP
// Rationale:    A secret failure (7000215 invalid, 7000222 expired) followed within 15 minutes by a success
//               for the same app from the same IP, where that app has not succeeded from that IP in the prior 30 days.
// MITRE ATT&CK: T1078.004 Valid Accounts: Cloud Accounts
//               T1550.001 Application Access Token
// ----------------------------------------------------------------------------
let Lookback = 1d;   // use 7d for a retro hunt
let Window = 15m;
let Baseline = EntraIdSpnSignInEvents
    | where Timestamp between (ago(30d) .. ago(Lookback))
    | where ErrorCode == 0 and isnotempty(IPAddress)
    | distinct ServicePrincipalId, IPAddress;
let Failed = EntraIdSpnSignInEvents
    | where Timestamp > ago(Lookback)
    | where ErrorCode in (7000215, 7000222) and isnotempty(IPAddress)
    | project FailTime = Timestamp, ServicePrincipalId, ServicePrincipalName, ApplicationId, IPAddress, FailureCode = ErrorCode;
let Succeeded = EntraIdSpnSignInEvents
    | where Timestamp > ago(Lookback)
    | where ErrorCode == 0 and isnotempty(IPAddress)
    | project SuccessTime = Timestamp, ServicePrincipalId, IPAddress, ResourceDisplayName, UserAgent;
Failed
| join kind=leftanti Baseline on ServicePrincipalId, IPAddress
| join kind=inner Succeeded on ServicePrincipalId, IPAddress
| where SuccessTime between (FailTime .. (FailTime + Window))
| summarize FirstFailure = min(FailTime), FirstSuccess = min(SuccessTime),
            FailedAttempts = dcount(FailTime), FailureCodes = make_set(FailureCode),
            Resources = make_set(ResourceDisplayName, 10), UserAgents = make_set(UserAgent, 5)
            by ServicePrincipalId, ServicePrincipalName, ApplicationId, IPAddress
| order by FirstSuccess desc
