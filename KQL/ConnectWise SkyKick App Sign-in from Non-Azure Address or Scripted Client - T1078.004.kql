// Title:       ConnectWise SkyKick App Sign-in from Non-Azure Address or Scripted Client.kql	
// Rationale:   Flags sign-ins by the seven ConnectWise Cloud Backup / Cloud Management
//              service principals from outside the Azure private IPv6 (fd...) range the
//              vendor apps normally use, or from a scripted client (python-urllib, python-
//              requests, curl): app-only use of the stolen vendor credential.
// MITRE ATT&CK: T1078.004 — Cloud Accounts
//               T1199 — Trusted Relationship
// Reference:  https://www.huntress.com/blog/vendor-credential-enables-unauthorized-access
let Lookback = 30d; // use 1d for a scheduled rule
let CWApps = dynamic([
 "506e08f9-6e9a-4da4-942b-a099a03644ae", // Cloud Backup (formerly SkyKick)
 "2399d300-6fca-4e6a-a686-399fefe75b83", // Cloud Management
 "24205314-2b89-4e07-a2a4-579e898a5640", // Cloud Management - MS Teams
 "b78f6a77-d4e5-46fb-87e5-d1648bd02519", // Cloud Management - Exchange Online
 "0de14c77-b9b0-4137-9360-34878a929827", // Cloud Management - MS Graph
 "412dcf96-176d-4b3a-a1b0-4981ad66971e", // Cloud Management - Partner Center
 "b2b55f5b-7758-4719-8d8f-88ae172e6bdb"  // Cloud Management - SharePoint Online
]);
EntraIdSpnSignInEvents
| where Timestamp > ago(Lookback)
| where ApplicationId in (CWApps)
| extend NonAzureAddress = isnotempty(IPAddress) and not(IPAddress startswith "fd"),
         ScriptedClient = UserAgent matches regex @"(?i)python-urllib|python-requests|curl/"
| where NonAzureAddress or ScriptedClient
| extend Reason = case(
            NonAzureAddress and ScriptedClient, "Non-Azure address + scripted client",
            NonAzureAddress, "Non-Azure address",
            "Scripted client"),
         Outcome = iff(ErrorCode == 0, "Success", "Failed"),
         Rank = iff(NonAzureAddress and ScriptedClient, 0, 1)
| order by Rank asc, Timestamp desc
| project Timestamp, ReportId, Reason, Outcome, Application, ApplicationId,
          ServicePrincipalName, ServicePrincipalId, IPAddress, Country, UserAgent,
          ResourceDisplayName, ErrorCode
