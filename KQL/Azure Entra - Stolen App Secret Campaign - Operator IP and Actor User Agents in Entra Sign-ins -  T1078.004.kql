// Hunt:        Azure Entra - Stolen App Secret Campaign - Operator IP and Actor User Agents in Entra Sign-ins
// Rationale:   Hunt Entra sign-ins from the operator IP, or with the two client fingerprints Todyl reports as unique to this actor.
//              These are the highest-confidence indicators in the campaign, so a successful hit means a stolen app secret worked in your tenant.
//              The low-confidence spray IPs are off by default; enable them only for hunting, since a hit there indicates targeting, not compromise.
//              Block exact IPs only, never the ASN. Microsoft service IPs seen in logs are not actor infrastructure.
// MITRE ATT&CK: T1078.004 Valid Accounts: Cloud Accounts; T1550.001 Use Alternate Authentication Material: Application Access Token (T1110.003 Password Spraying applies only to the optional spray IPs)
// Threat Intel Reference:   https://www.todyl.com/blog/stolen-app-credentials-real-access-an-actor-is-signing-into-entra-id-and-azure-devops-as-your-workloads
// ----------------------------------------------------------------------------
let Lookback = 30d;               // use 1d for a scheduled rule
let IncludeLowConfidence = false; // true = also match the two spray IPs (hunting only)
let OperatorIP = "199.19.77.84";
let LowConfidenceIPs = dynamic(["199.19.77.18","65.87.223.26"]);
union
 (EntraIdSpnSignInEvents
  | where Timestamp > ago(Lookback)
  | where IPAddress == OperatorIP
      or UserAgent contains "sait-tenant-deep" or UserAgent contains "task177-f2267"
      or (IncludeLowConfidence and IPAddress in (LowConfidenceIPs))
  | project Timestamp, ReportId, SignInType = "ServicePrincipal", Application, ApplicationId,
            Account = ServicePrincipalName, AccountId = ServicePrincipalId,
            IPAddress, UserAgent, ResourceDisplayName, ErrorCode, Country),
 (EntraIdSignInEvents
  | where Timestamp > ago(Lookback)
  | where IPAddress == OperatorIP
      or UserAgent contains "sait-tenant-deep" or UserAgent contains "task177-f2267"
      or (IncludeLowConfidence and IPAddress in (LowConfidenceIPs))
  | project Timestamp, ReportId, SignInType = "User", Application, ApplicationId,
            Account = AccountUpn, AccountId = AccountObjectId,
            IPAddress, UserAgent, ResourceDisplayName, ErrorCode, Country)
| extend Outcome = iff(ErrorCode == 0, "Success", "Failed")
| extend Confidence = case(
    IPAddress == OperatorIP, "High: operator IP",
    UserAgent contains "sait-tenant-deep" or UserAgent contains "task177-f2267", "High: actor user agent",
    "Low-moderate: spray IP")
| extend Rank = case(
    Outcome == "Success" and Confidence startswith "High", 0,
    Confidence startswith "High", 1,
    2)
| order by Rank asc, Timestamp desc
| project-away Rank
